generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OtpChannel {
  WHATSAPP
  SMS
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  DELIVERY_FAILED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  apiKeys   ApiKey[]
  otpEvents OtpEvent[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  keyHash    String   @unique
  active     Boolean  @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  @@index([tenantId])
}

model OtpEvent {
  id             String     @id @default(cuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  destinationHash String
  destinationTail String
  purpose        String
  channel        OtpChannel
  status         OtpStatus  @default(PENDING)
  providerRef    String?
  attempts       Int        @default(0)
  expiresAt      DateTime
  verifiedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  @@index([tenantId, createdAt])
  @@index([destinationHash, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  action    String
  subjectId String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
}
